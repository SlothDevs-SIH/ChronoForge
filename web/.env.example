# Copy to .env.local for local overrides. Never commit real keys: the anon key is public by design, but keep it out of git anyway.

# Where the services live. Leave unset locally: the Vite dev proxy answers on /api/engine and /api/agent.
# In production (Vercel) set both to the Render service URLs, for example https://trueclose-engine.onrender.com
VITE_ENGINE_URL=
VITE_AGENT_URL=

# Supabase project (Settings > API). Without these a production build shows "Sign-in isn't set up yet".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local demo only: skip sign-in when the backends run with AUTH_REQUIRED=0. Never set this in production.
VITE_AUTH_DISABLED=
