# Engine service. Copy to .env for local runs; on Render set these in the dashboard. Never commit real values.
PORT=8001

# --- authentication (see contract/AUTH_AND_DEPLOY.md) ---
AUTH_REQUIRED=0                      # 1 in production; 0 keeps the laptop demo open
SUPABASE_URL=                        # https://<project>.supabase.co  (JWKS is read from it)
SUPABASE_JWT_SECRET=                 # optional: HS256 projects and tests; leave empty to use JWKS
SUPABASE_JWT_AUDIENCE=authenticated
AGENT_URL=                           # https://<agent service>; used to look up the caller's role
ENGINE_SERVICE_TOKEN=                # shared with the Agent; required on /muni/* when AUTH_REQUIRED=1
ENGINE_ADMIN_TOKEN=                  # optional: lets scripts call POST /connectors/{name}/sync
CORS_ORIGINS=http://localhost:5174   # comma separated allowlist, e.g. https://trueclose-neon.vercel.app

# --- data ---
WAREHOUSE_DIR=                       # default data/warehouse; /var/data/warehouse in the image (persistent disk)
WAREHOUSE_URL=                       # private URL of warehouse.tar.gz, fetched at start if the directory is empty
ENGINE_DATA_MODE=auto                # auto | warehouse | fixtures
SAT_CACHE_DIR=                       # satellite result cache; default data/cache/satellite
CONTRACT_DIR=                        # default ./contract
