    "/satellite/check": {
      "post": {
        "summary": "Satellite Check",
        "description": "Real Sentinel-2 check. Ineligible tickets (wrong category, no exact point, no closing date) return inconclusive at\ncost 0. Eligible ones read imagery live (10 to 60 s) or from the cache; cached_only=true never reads live and answers\ninstantly. details.source says \"live\" or \"cached\". Cloud, missing scenes and read errors abstain (inconclusive).",
        "operationId": "satellite_check_satellite_check_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SatelliteCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evidence"
                }
              }
            }
