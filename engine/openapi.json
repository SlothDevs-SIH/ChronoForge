  "components": {
    "schemas": {
      "Evidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "check": {
            "type": "string",
            "enum": [
              "photo",
              "satellite",
              "citizen",
              "human"
            ],
            "title": "Check"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supports_fix",
              "contradicts_fix",
              "inconclusive"
            ],
            "title": "Verdict"
          },
          "likelihood_ratio": {
            "type": "number",
            "title": "Likelihood Ratio"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "cost": {
            "type": "integer",
            "title": "Cost"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "ticket_id",
          "check",
          "verdict",
          "likelihood_ratio",
          "confidence",
          "cost",
          "details",
          "created_at"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MuniActionResult": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "reopened"
            ],
            "title": "Status"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
