# Agent service environment. Copy to .env for local runs; on Render set each of these in the service's Environment tab.
# NEVER commit real values. Everything below is empty or a safe local default.

# ---- core ------------------------------------------------------------------------------------------------------
ENGINE_URL=http://localhost:8001      # the Engine's base URL (on Render: its https address)
AGENT_USE_STUBS=1                     # 0 for real services: the Engine must be reachable. 1 = canned stub tools (plumbing only)
AGENT_ALLOW_STUB_FALLBACK=0           # 1 lets an unreachable Engine fall back to stub priors (never in production)
STEP_DELAY=0.4                        # seconds between steps (a visible live trace)
OUTCOME_CHECK_DELAY=30                # seconds after an approved action before the outcome re-check
SATELLITE_TIMEOUT=120                 # a live Sentinel-2 read takes 20 to 60 s

# ---- database --------------------------------------------------------------------------------------------------
# Leave DATABASE_URL empty for local SQLite (AGENT_DB). With a Postgres URL the app NEVER creates tables: a person runs
# agent/sql/schema_postgres.sql once in the Supabase SQL editor first.
DATABASE_URL=                         # e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AGENT_DB=agent.db
PHOTO_INDEX=data/photo_index.json     # duplicate-photo memory; put it on a persistent disk in production

# ---- sign-in and roles (Supabase Auth) -------------------------------------------------------------------------
AUTH_REQUIRED=0                       # 1 in production. 0 = local demo, every request is treated as a local admin
SUPABASE_URL=                         # https://<project-ref>.supabase.co (JWKS is read from here for ES256/RS256 tokens)
SUPABASE_JWT_SECRET=                  # only for projects that sign with the legacy HS256 secret (Project Settings > API)
SUPABASE_JWT_AUDIENCE=authenticated
ADMIN_EMAILS=                         # comma-separated emails of the first admins; the email must be confirmed in Supabase
PUBLIC_DEMO_RUNS=0                    # 1 lets anyone run and watch DEMO-* tickets (the public System status page); real tickets stay private

# ---- service-to-service ----------------------------------------------------------------------------------------
ENGINE_SERVICE_TOKEN=                 # long random string, the same value on the Engine; sent as X-Service-Token
AGENT_ADMIN_TOKEN=                    # optional shared secret for scripts (X-Admin-Token) on the citizen/contact endpoints
REPLY_LINK_SECRET=                    # long random string; signs citizen reply links and local signed photo URLs

# ---- hosting ---------------------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5174    # comma-separated allowlist of web origins, e.g. https://trueclose-neon.vercel.app
TRUST_PROXY=0                         # 1 behind Render/another proxy so rate limits see the real client address
RATE_LIMITS_ENABLED=1
PORT=8002

# ---- evidence photo storage ------------------------------------------------------------------------------------
STORAGE_BACKEND=local                 # local | supabase
UPLOAD_DIR=data/uploads               # local backend only
SUPABASE_SERVICE_KEY=                 # service_role key: server only, never in the browser. Needed for STORAGE_BACKEND=supabase
SUPABASE_BUCKET=evidence              # create it as a PRIVATE bucket
SIGNED_URL_SECONDS=300

# ---- channels and models (all optional) ------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=0                    # 1 to long-poll (one process only); otherwise set a webhook with TELEGRAM_WEBHOOK_SECRET
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=                       # parked: WhatsApp is not finished
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDERS=gemini,openai           # tried in order, then the deterministic planner
LLM_TIMEOUT=8
AGENT_USE_LLM_PLANNER=0
AGENT_USE_SKEPTIC=0
AGENT_USE_CLIP=0                      # needs requirements-clip.txt (torch, ~2 GB) and a host with several GB of RAM
AGENT_USE_DINO=0
AGENT_USE_VISION_LLM=0                # sends demo photos to Google: demo photos only

# ---- website requests and case tracking ----
AGENT_WATCH_INTERVAL=15               # seconds between checks for tickets the city has closed (0 = off); needs AGENT_USE_STUBS=0
TELEGRAM_POLLING=1                    # the bot listens without a public URL; run ONE agent per bot token
# AGENT_REQUESTS_PER_HOUR=10          requests one citizen may file per hour
# AGENT_REMINDER_HOURS=24             remind once after this long without an answer
# AGENT_ESCALATE_HOURS=48             then send the case to a person
# AGENT_PHOTO_DIR=/data/citizen_photos   photos citizens send in the chat (keep on a persistent disk)
