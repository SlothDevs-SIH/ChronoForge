ENGINE_URL=http://localhost:8001
AGENT_DB=agent.db
AGENT_USE_STUBS=1          # 0 once the Engine is running
STEP_DELAY=0.4             # seconds between steps (visible live trace)
OUTCOME_CHECK_DELAY=30     # demo mode
# Wired later (never commit real values):
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=1            # long-poll, no public URL needed
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDERS=gemini,openai   # tried in order, then the deterministic planner
AGENT_USE_LLM_PLANNER=0       # 1 to let the LLM choose tools
AGENT_USE_CLIP=0              # 1 once torch + open_clip_torch are installed
GEMINI_MODEL=gemini-flash-lite-latest   # alias that tracks the current lite model
OPENAI_MODEL=gpt-4o-mini
WHATSAPP_TOKEN=               # Meta access token (temporary ones expire in about 24 h)
WHATSAPP_PHONE_NUMBER_ID=     # the test number's Phone number ID from API Setup
WHATSAPP_VERIFY_TOKEN=        # any string you choose; paste the same one into the Meta webhook settings

# Sign-in and roles
AGENT_AUTH_SECRET=change-me-to-a-long-random-string
AGENT_FIRST_ADMIN_EMAIL=
AGENT_FIRST_ADMIN_PASSWORD=
# AGENT_AUTH_ENFORCE=0 turns role checks off (laptop demo only)

# Case tracking: seconds between checks for tickets the city has closed (0 = off). Run the Agent with AGENT_USE_STUBS=0.
AGENT_WATCH_INTERVAL=15
